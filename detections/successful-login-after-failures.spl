# Detection: Successful Login After Repeated Failures

# Purpose: Identify successful logins with at least 4 failed login events

# in the preceding rolling 5-minute window for the same username and source IP.

# Data source: Synthetic authentication dataset.

# Limitation: This pattern warrants investigation but does not prove account compromise.

index=main source="*authentication_logs.csv*" event_type="login"
| eval failed=if(status="failure",1,0)
| eval successful=if(status="success",1,0)
| sort 0 _time
| streamstats time_window=5m sum(failed) AS failures_5m BY username source_ip
| where successful=1 AND failures_5m>=4
| table _time username source_ip status failures_5m
| sort - failures_5m
